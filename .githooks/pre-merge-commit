#!/usr/bin/env bash
# git pre-merge-commit 훅 — non-fast-forward 병합 커밋도 pre-commit 과 같은 도장 검증을 받게 한다 (git 2.24+).
# git 은 병합 커밋에 pre-commit 을 돌리지 않으므로, 이 훅이 없으면 도장 없는 병합이 HEAD 를 전진시킨다(K2 3회전 발견).
# cherry-pick·revert·rebase 재생 커밋은 git 이 차단형 pre-* 훅을 제공하지 않아 이 방식으로는 못 막는다 — CLAUDE.md 한계 참조.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STAMP="$ROOT/.claude/scripts/review-stamp.sh"

# 사용자 자신의 병합은 막지 않는다 (pre-commit 과 같은 이유·같은 한계 — 표식을 비우면 꺼진다).
if [ -z "${CLAUDECODE:-}" ] && [ -z "${AI_AGENT:-}" ]; then
  exit 0
fi

if [ ! -x "$STAMP" ]; then
  echo "커밋 차단: 리뷰 도장 스크립트를 찾을 수 없다 ($STAMP)" >&2
  exit 1
fi
if "$STAMP" --verify; then
  exit 0
fi
echo "커밋 차단: 병합 커밋의 트리에 /kit-review 통과 도장이 없다." >&2
echo "  해결: /kit-review 통과 후 '.claude/scripts/review-stamp.sh --write' 로 도장을 찍고 병합한다." >&2
echo "  훅을 우회하지 않는다 — 막힌 이유를 해결하거나 사용자에게 보고한다." >&2
exit 1
